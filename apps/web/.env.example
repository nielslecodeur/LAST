# Copy to .env.local (git-ignored). NEAR TESTNET ONLY — a mainnet (.near) id is refused by the app.
#
# Contract account of the deployed LAST contract (filled in at Gate 3, after an approved deploy).
# Leave empty: the UI shows "CONTRACT NOT DEPLOYED" and every blockchain action stays disabled.
VITE_LAST_CONTRACT_ID=

# Optional: comma-separated testnet RPC endpoints, tried in order on network errors.
# VITE_NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org
# (do not use rpc.testnet.near.org: deprecated, answers 429)

# Optional: block explorer base URL.
# VITE_EXPLORER_URL=https://testnet.nearblocks.io
